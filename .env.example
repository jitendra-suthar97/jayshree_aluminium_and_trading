# Public site URL (no trailing slash). Used for canonical URLs, sitemap, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://example.in

# Web3Forms access key (public by design). Without it the quote form is replaced by Call/WhatsApp buttons.
NEXT_PUBLIC_WEB3FORMS_KEY=f5956f5f-b5b0-4146-9d37-b65c102088b0

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Leave empty to disable analytics entirely.
NEXT_PUBLIC_GA_ID=

# Development only: show clearly-labelled placeholders where real photos are still missing.
# Never set this to true in production.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=true
